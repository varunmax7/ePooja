# Copy to .env and fill in only what you need. The app runs fully as a guest
# with none of these set (§5 "Guest-first", §13).

APP_ENV=development

# Supabase (Phase 8) — profile sync and content packs
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Sentry (§12) — crash reporting; disabled in dev builds
EXPO_PUBLIC_SENTRY_DSN=

# PostHog (§12) — privacy-safe funnels; never devotee data
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# EAS project id (filled by `eas init`)
EAS_PROJECT_ID=
